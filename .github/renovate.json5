{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>trueforge-org/renovate-config"
  ],
  "packageRules": [
    {
      // Stay on Kubernetes 1.36 (talconfig.yaml + upgradesettings.yaml): 1.37 needs a newer Talos.
      // Lift together with the Talos 1.14 upgrade.
      "description": "Keep Kubernetes (kubelet) below 1.37",
      "matchPackageNames": ["ghcr.io/siderolabs/kubelet"],
      "allowedVersions": "<1.37.0"
    },
    {
      // Longhorn only supports upgrading from the previous minor version, and a
      // failed pre-upgrade check leaves the release stuck. Review these manually.
      "description": "Do not automerge Longhorn chart updates",
      "matchDepNames": ["longhorn"],
      "automerge": false
    },
    {
      // Immich is pinned (helm-release.yaml) until its major upgrade is done:
      // Immich 3.x needs the pgvecto.rs -> VectorChord DB migration (migration/UPGRADE-PAPERLESS-IMMICH.md).
      "description": "Major updates of Immich need a manual migration",
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
