{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>trueforge-org/renovate-config"
  ],
  "packageRules": [
    {
      // Stay on Kubernetes 1.36 (talconfig.yaml + upgradesettings.yaml): 1.37 needs a newer Talos.
      // Lift together with the Talos 1.14 upgrade.
      "description": "Keep Kubernetes (kubelet) below 1.37",
      "matchPackageNames": ["ghcr.io/siderolabs/kubelet"],
      "allowedVersions": "<1.37.0"
    },
    {
      // Longhorn only supports upgrading from the previous minor version, and a
      // failed pre-upgrade check leaves the release stuck. Review these manually.
      "description": "Do not automerge Longhorn chart updates",
      "matchDepNames": ["longhorn"],
      "automerge": false
    },
    {
      // TrueNAS K3s migration: these apps share data with the stopped K3s copies (NFS) or are pinned
      // to the K3s version so rollback stays possible. Review manually until the rollback window
      // has ended (>= 2026-11-25), then remove this rule.
      "description": "Do not automerge apps in the K3s migration rollback window",
      "matchPackageNames": [
        "oci.trueforge.org/containerforge/jellyfin",
        "oci.trueforge.org/containerforge/plex",
        "oci.trueforge.org/containerforge/home-assistant",
        "ghcr.io/paperless-ngx/paperless-ngx",
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "automerge": false
    },
    {
      "description": "Do not automerge charts of apps in the K3s migration rollback window",
      "matchDepNames": ["jellyfin", "plex", "home-assistant", "paperless-ngx", "immich"],
      "automerge": false
    }
  ]
}
